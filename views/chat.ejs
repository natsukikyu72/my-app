<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>購入相談</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/header") %>

<div class="container">

<div class="page-header">
<h1>
<%= myId===chatRoom.sellerId ? chatRoom.buyer.name : chatRoom.seller.name %> さんとのチャット
</h1>

<a href="/listing/<%= chatRoom.listing.id %>">
← 商品ページへ戻る
</a>
</div>


<div class="card">

<h2><%= chatRoom.listing.book.title %></h2>

<p>📖 <%= chatRoom.listing.book.courseName %></p>

<p class="price">
¥<%= chatRoom.listing.price.toLocaleString() %>
</p>

<p>
状態：
<%= chatRoom.listing.condition ?? "未設定" %>
</p>

<p>

<% if(myId===chatRoom.sellerId){ %>

購入希望者：
<a href="/user/<%= chatRoom.buyer.id %>">
<%= chatRoom.buyer.name %>
</a>

<% }else{ %>

出品者：
<a href="/user/<%= chatRoom.seller.id %>">
<%= chatRoom.seller.name %>
</a>

<% } %>

</p>

</div>


<h2 style="margin:30px 0 15px;">
メッセージ
</h2>


<% if(chatRoom.messages.length===0){ %>

<div class="card">
まだメッセージはありません。
</div>

<% } %>


<% chatRoom.messages.forEach(message=>{ %>

<div class="message <%= message.senderId===myId ? 'mine' : 'other' %>">

<div class="bubble">

<strong>
<a href="/user/<%= message.sender.id %>">
<%= message.sender.name %>
</a>
</strong>

<div class="content">
<%= message.content %>
</div>

<div class="small">

<%= new Date(message.createdAt).toLocaleString("ja-JP",{
timeZone:"Asia/Tokyo",
year:"numeric",
month:"2-digit",
day:"2-digit",
hour:"2-digit",
minute:"2-digit"
}) %>

</div>

</div>

</div>

<% }) %>


<%
const canSend =
chatRoom.listing.status==="SELLING" ||
chatRoom.listing.buyerId===chatRoom.buyerId;
%>


<% if(canSend){ %>

<form action="/chat/<%= chatRoom.id %>/message" method="post">

<textarea
name="content"
placeholder="メッセージを入力"
required></textarea>

<div style="margin-top:15px;">

<button>
送信
</button>

</div>

</form>

<% }else{ %>

<div class="card warning">

この商品は他の購入希望者との取引が成立したため、
チャット履歴のみ閲覧できます。

</div>

<% } %>


<% if(chatRoom.sellerId===myId){ %>

<% if(chatRoom.listing.status==="SELLING"){ %>

<div style="margin-top:20px;">

<form action="/chat/<%= chatRoom.id %>/accept" method="post">

<button>
この人と取引する
</button>

</form>

</div>

<% }else if(chatRoom.listing.buyerId===chatRoom.buyerId){ %>

<div class="card success">

✅ この購入希望者と現在取引中です。

</div>

<% } %>

<% } %>


<% if(
chatRoom.listing.status==="RESERVED" &&
chatRoom.listing.buyerId===chatRoom.buyerId
){ %>

<div style="margin-top:20px;">

<form action="/listing/<%= chatRoom.listing.id %>/complete" method="post">

<button>
受け渡し完了
</button>

</form>

</div>

<% } %>

</div>

</body>
</html>