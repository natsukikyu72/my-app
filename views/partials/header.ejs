<header class="navbar">
  <div class="navbar-brand">
    <a href="/" class="brand-link">
      <img src="/images/keio-icon.png" alt="慶應" class="header-logo" onError="this.style.display='none'">
      <div class="brand-text">
        <span class="brand-sub">慶應義塾生専用</span>
        <span class="brand-title">📚 教科書フリマ</span>
      </div>
    </a>
  </div>

  <nav class="navbar-menu">
    <a href="/" class="nav-item">
      <span>ホーム</span>
    </a>

    <a href="/user/<%= myId %>" class="nav-item nav-link">
      <span>マイページ</span>
      <% if(hasUnread){ %>
        <span class="red-dot" title="未読メッセージがあります"></span>
      <% } %>
    </a>

    <a href="/listing/new" class="nav-item nav-btn-sell">
      <span>＋ 出品する</span>
    </a>

    <form action="/logout" method="post" class="logout-form">
      <button type="submit" class="btn-logout">
        ログアウト
      </button>
    </form>
  </nav>
</header>