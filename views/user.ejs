<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title><%= user.name %></title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/header") %>

<div class="container">

<h1><%= user.name %></h1>

<%
let avg = 0;
if(user.reviewsReceived.length){
    avg = (
        user.reviewsReceived.reduce((a,r)=>a+r.rating,0)
        / user.reviewsReceived.length
    ).toFixed(1);
}
%>

<div class="card">

<h2>プロフィール</h2>

<p><strong>キャンパス：</strong><%= user.campus %></p>
<p><strong>学部：</strong><%= user.department %></p>
<p><strong>学年：</strong><%= user.grade %></p>

<p style="margin-top:15px;">
<a href="/user/<%= user.id %>/reviews">
⭐ <%= avg %>（<%= user.reviewsReceived.length %>件）
</a>
</p>

<% if(user.id===myId){ %>

<p style="margin-top:20px;">
<a href="/profile/edit">
<button>プロフィール編集</button>
</a>
</p>

<% } %>

</div>

<%
const selling=user.listings.filter(l=>l.status==="SELLING");
%>

<h2>📚 出品中の商品</h2>

<% if(selling.length===0){ %>

<div class="card">
出品中の商品はありません。
</div>

<% }else{ %>

<div class="listing-grid">

<% selling.forEach(listing=>{ %>

<a href="/listing/<%= listing.id %>" class="listing-link">

<div class="listing-card">

<%
const hasUnreadChat = listing.chatRooms.some(
  chat => chat.messages.length > 0
);
%>

<% if(hasUnreadChat){ %>
<span class="card-dot"></span>
<% } %>

<div class="image-wrapper">

<img
src="<%= listing.imageUrl || '/images/no-image.png' %>"
class="book-image">

<span class="status <%= listing.status.toLowerCase() %>">

<%= listing.status==="SELLING"
? "販売中"
: listing.status==="RESERVED"
? "取引中"
: "売却済み" %>

</span>

</div>

<h3><%= listing.book.title %></h3>

<p>📖 <%= listing.book.courseName %></p>

<p class="price">
¥<%= listing.price.toLocaleString() %>
</p>

<p class="original">
定価 ¥<%= listing.book.originalPrice.toLocaleString() %>
</p>

<p class="seller">
👤 <%= listing.seller.name %>
</p>

<span class="campus-tag">
🏫 <%= listing.seller.campus %>
</span>

<p class="condition">
状態：<%= listing.condition ?? "未設定" %>
</p>

</div>

</a>

<% }) %>

</div>

<% } %>

<% if(user.id===myId){ %>

<h2>🛒 購入取引中の商品</h2>

<% if(user.purchases.length===0){ %>

<div class="card">
現在取引中の商品はありません。
</div>

<% }else{ %>

<div class="listing-grid">

<% user.purchases.forEach(purchase=>{ %>

<a href="/listing/<%= purchase.id %>" class="listing-link">

<div class="listing-card">

<%
const hasUnreadChat = listing.chatRooms.some(
  chat => chat.messages.length > 0
);
%>

<% if(hasUnreadChat){ %>
<span class="card-dot"></span>
<% } %>


<div class="image-wrapper">

<img
src="<%= purchase.imageUrl || '/images/no-image.png' %>"
class="book-image">

<span class="status <%= purchase.status.toLowerCase() %>">

<%= purchase.status==="SELLING"
? "販売中"
: purchase.status==="RESERVED"
? "取引中"
: "売却済み" %>

</span>

</div>

<h3><%= purchase.book.title %></h3>

<p>📖 <%= purchase.book.courseName %></p>

<p class="price">
¥<%= purchase.price.toLocaleString() %>
</p>

<p class="original">
定価 ¥<%= purchase.book.originalPrice.toLocaleString() %>
</p>

<p class="seller">
👤 <%= purchase.seller.name %>
</p>

<span class="campus-tag">
🏫 <%= purchase.seller.campus %>
</span>

<p class="condition">
状態：<%= purchase.condition ?? "未設定" %>
</p>

</div>

</a>

<% }) %>

</div>

<% } %>

<h2>💬 相談中の商品</h2>

<%
const chatting=user.buyerChats.filter(chat=>chat.listing.status==="SELLING");
%>

<% if(chatting.length===0){ %>

<div class="card">
相談中の商品はありません。
</div>

<% }else{ %>

<div class="listing-grid">

<% chatting.forEach(chat=>{ %>

<a href="/chat/<%= chat.id %>" class="listing-link">

<div class="listing-card">

<%
const hasUnreadChat = listing.chatRooms.some(
  chat => chat.messages.length > 0
);
%>

<% if(hasUnreadChat){ %>
<span class="card-dot"></span>
<% } %>

<div class="image-wrapper">

<img
src="<%= chat.listing.imageUrl || '/images/no-image.png' %>"
class="book-image">

<span class="status <%= chat.listing.status.toLowerCase() %>">

<%= chat.listing.status==="SELLING"
? "販売中"
: chat.listing.status==="RESERVED"
? "取引中"
: "売却済み" %>

</span>

</div>

<h3><%= chat.listing.book.title %></h3>

<p>📖 <%= chat.listing.book.courseName %></p>

<p class="price">
¥<%= chat.listing.price.toLocaleString() %>
</p>

<p class="original">
定価 ¥<%= chat.listing.book.originalPrice.toLocaleString() %>
</p>

<p class="seller">
👤 <%= chat.listing.seller.name %>
</p>

<span class="campus-tag">
🏫 <%= chat.listing.seller.campus %>
</span>

<p class="condition">
状態：<%= chat.listing.condition ?? "未設定" %>
</p>

</div>

</a>

<% }) %>

</div>

<% } %>

<% } %>

</div>

</body>
</html>