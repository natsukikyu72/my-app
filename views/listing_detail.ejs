<!DOCTYPE html>
<html lang="ja">

<head>
<meta charset="UTF-8">
<title><%= listing.book.title %></title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/header") %>

<div class="container">

<div class="detail-card">

<div class="image-wrapper">
<img src="<%= listing.imageUrl || '/images/no-image.png' %>" class="detail-image">

<span class="status <%= listing.status.toLowerCase() %>">
<%= listing.status==="SELLING"
? "販売中"
: listing.status==="RESERVED"
? "取引中"
: "売却済み" %>
</span>
</div>

<h1><%= listing.book.title %></h1>

<p>📖 授業<br><%= listing.book.courseName %></p>

<p class="price">
¥<%= listing.price.toLocaleString() %>
</p>

<p>
定価：
<%= listing.book.originalPrice.toLocaleString() %>円
</p>

<p>
状態：
<%= listing.condition ?? "未設定" %>
</p>

<p>
出品者：
<a href="/user/<%= listing.seller.id %>">
<%= listing.seller.name %>
</a>
</p>

</div>


<!-- 購入者・閲覧者側 -->

<% if(listing.sellerId!==myId){ %>

<% if(!myChat && listing.status==="SELLING"){ %>

<form action="/chat/start/<%= listing.id %>" method="post">
<button class="main-button">
購入相談する
</button>
</form>

<% } %>

<% if(myChat){ %>

<a href="/chat/<%= myChat.id %>">
<button class="main-button">
<%= listing.buyerId===myId ? "取引中チャットを見る" : "チャット履歴を見る" %>
</button>
</a>

<% } %>

<%
const alreadyReviewed =
listing.reviews.some(
r=>r.reviewerId===myId
);
%>


<% if(
listing.status==="SOLD" &&
!alreadyReviewed &&
listing.buyerId===myId
){ %>

<a href="/review/new/<%= listing.id %>">

<button>
⭐ 評価する
</button>

</a>

<% } %>


<% } %>



<!-- 出品者側 -->

<% if(listing.sellerId===myId){ %>

<%
const acceptedChat = 
(listing.status==="RESERVED" || listing.status==="SOLD")
? listing.chatRooms.find(chat=>chat.buyerId===listing.buyerId)
: null;
%>


<!-- 成立済み取引 -->

<% if(acceptedChat){ %>

<h2>🤝 取引中</h2>

<div class="chat-card accepted-chat">

<p>
購入者：
<a href="/user/<%= acceptedChat.buyer.id %>">
<%= acceptedChat.buyer.name %>
</a>
</p>

<% if(acceptedChat.messages.length){ %>

<p>
最新：
<%= acceptedChat.messages[0].content %>
</p>

<p class="small">
<%= new Date(acceptedChat.messages[0].createdAt).toLocaleString("ja-JP",{
timeZone:"Asia/Tokyo",
year:"numeric",
month:"2-digit",
day:"2-digit",
hour:"2-digit",
minute:"2-digit"
}) %>
</p>

<% }else{ %>

<p>
メッセージなし
</p>

<% } %>

<a href="/chat/<%= acceptedChat.id %>">
<button class="main-button">
取引中チャットを見る
</button>
</a>

</div>

<% } %>



<!-- 評価 -->

<%
const alreadyReviewed = listing.reviews.some(
r=>r.reviewerId===myId
);
%>

<% if(
listing.status==="SOLD" &&
!alreadyReviewed &&
listing.sellerId===myId
){ %>

<a href="/review/new/<%= listing.id %>">
<button>
⭐ 評価する
</button>
</a>

<% } %>



<hr>



<!-- その他相談 -->

<h2>
<%= listing.status==="SELLING"
? "💬 購入相談"
: "💬 その他の購入相談" %>
</h2>

<%
const otherChats = listing.chatRooms.filter(
chat=>chat.buyerId!==listing.buyerId
);
%>

<% if(otherChats.length===0){ %>

<div class="chat-card">
他の相談はありません。
</div>

<% }else{ %>

<% otherChats.forEach(chat=>{ %>

<div class="chat-card">

<p>
購入希望者：
<a href="/user/<%= chat.buyer.id %>">
<%= chat.buyer.name %>
</a>
</p>

<% if(chat.messages.length){ %>

<p>
最新：
<%= chat.messages[0].content %>
</p>

<% }else{ %>

<p>
メッセージなし
</p>

<% } %>

<a href="/chat/<%= chat.id %>">
<button>
チャット履歴を見る
</button>
</a>

</div>

<% }) %>

<% } %>

<% } %>

</div>

</body>
</html>